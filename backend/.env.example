# Copy to backend/.env and fill in secrets. Never commit the real file.

# OpenAI. Used when LLM_PROVIDER=openai. The same tool list is used for Qwen.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Default when the customer has not chosen. The chat request can send openai or qwen.
LLM_PROVIDER=openai
LOCAL_MODEL_PATH=
LOCAL_MODEL_MAX_TOKENS=768

# Databricks workspace. The host is not a secret; the token is.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# SQL warehouse. Use the warehouse id, or the HTTP path /sql/1.0/warehouses/<id>.
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_SQL_TIMEOUT=180

# Notebook runs use serverless unless a cluster id is set.
DATABRICKS_USE_SERVERLESS=true
DATABRICKS_CLUSTER_ID=

# Unity Catalog location for uploads and generated notebooks.
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=dataflow
DATABRICKS_VOLUME=uploads
DATABRICKS_NOTEBOOK_DIR=/Workspace/Shared/dataflow-agent
