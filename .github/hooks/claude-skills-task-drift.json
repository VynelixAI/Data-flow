{
  "version": 1,
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "powershell": "$body = [Console]::In.ReadToEnd(); try { Invoke-WebRequest -UseBasicParsing -Uri 'http://127.0.0.1:51995/hook/task-drift?agent=copilot&cwd=%2FUsers%2Fpremkumargontrand%2FDownloads%2Fdataflow-agent' -Method POST -Headers @{ 'Content-Type' = 'application/json' } -Body $body | Out-Null } catch { }",
        "timeoutSec": 8
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "powershell": "$body = [Console]::In.ReadToEnd(); try { Invoke-WebRequest -UseBasicParsing -Uri 'http://127.0.0.1:51995/hook/task-drift?agent=copilot&cwd=%2FUsers%2Fpremkumargontrand%2FDownloads%2Fdataflow-agent' -Method POST -Headers @{ 'Content-Type' = 'application/json' } -Body $body | Out-Null } catch { }",
        "timeoutSec": 8
      }
    ]
  }
}
